@model BaiTapMVC.Models.Enrollment

@{
    ViewData["Title"] = "Chi tiết đăng ký";
}

<h2>Chi tiết đăng ký</h2>

<div>
    <p><strong>Sinh viên:</strong> @Model.Student.Name</p>
    <p><strong>Khóa học:</strong> @Model.CourseClass?.Course?.CourseName</p>
    <p><strong>Giáo viên:</strong> @Model.CourseClass?.Teacher?.Name</p>
</div>

<br />

<a asp-action="Edit" asp-route-id="@Model.EnrollmentId" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
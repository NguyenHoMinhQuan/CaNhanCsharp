@model IEnumerable<BaiTapMVC.Models.Enrollment>

@{
    ViewData["Title"] = "Danh sách đăng ký";
}

<h2>Danh sách đăng ký</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Đăng ký học</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Sinh viên</th>
            <th>Khóa học</th>
            <th>Giáo viên</th>
            <th width="250">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Student.Name</td>
                <td>@item.CourseClass?.Course?.CourseName</td>
                <td>@item.CourseClass?.Teacher?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.EnrollmentId">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@item.EnrollmentId">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.EnrollmentId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/" class="btn btn-dark">🏠 Dashboard</a>
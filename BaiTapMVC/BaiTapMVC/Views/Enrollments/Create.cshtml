@model BaiTapMVC.Models.Enrollment

@{
    ViewData["Title"] = "Đăng ký học";
}

<h2>Đăng ký học</h2>

<form asp-action="Create">
    <div class="form-group">
        <label>Sinh viên</label>
        <select asp-for="StudentId" asp-items="ViewBag.StudentId" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Lớp học phần</label>
        <select asp-for="CourseClassId" asp-items="ViewBag.CourseClassId" class="form-control"></select>
    </div>

    <br />
    <button type="submit" class="btn btn-success">Đăng ký</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
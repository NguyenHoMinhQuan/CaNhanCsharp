@model BaiTapMVC.Models.Enrollment

@{
    ViewData["Title"] = "Sửa đăng ký";
}

<h2>Sửa đăng ký</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="EnrollmentId" />

    <div class="form-group">
        <label>Sinh viên</label>
        <select asp-for="StudentId" asp-items="ViewBag.StudentId" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Lớp học phần</label>
        <select asp-for="CourseClassId" asp-items="ViewBag.CourseClassId" class="form-control"></select>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
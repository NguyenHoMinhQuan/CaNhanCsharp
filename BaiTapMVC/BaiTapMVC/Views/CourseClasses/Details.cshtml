@model BaiTapMVC.Models.CourseClass

@{
    ViewData["Title"] = "Chi tiết lớp học phần";
}

<h2>Chi tiết lớp học phần</h2>

<div>
    <p><strong>ID:</strong> @Model.CourseClassId</p>
    <p><strong>Khóa học:</strong> @Model.Course.CourseName</p>
    <p><strong>Giáo viên:</strong> @Model.Teacher.Name</p>
</div>

<br />

<a asp-action="Edit" asp-route-id="@Model.CourseClassId" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
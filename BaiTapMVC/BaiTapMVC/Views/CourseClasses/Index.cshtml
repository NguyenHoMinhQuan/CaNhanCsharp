@model IEnumerable<BaiTapMVC.Models.CourseClass>

@{
    ViewData["Title"] = "Lớp học phần";
}

<h2>Lớp học phần</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Thêm lớp</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Khóa học</th>
            <th>Giáo viên</th>
            <th width="250">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Course.CourseName</td>
                <td>@item.Teacher.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.CourseClassId">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@item.CourseClassId">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.CourseClassId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/" class="btn btn-dark">🏠 Dashboard</a>
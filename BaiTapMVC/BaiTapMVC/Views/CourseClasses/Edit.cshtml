@model BaiTapMVC.Models.CourseClass

@{
    ViewData["Title"] = "Sửa lớp học phần";
}

<h2>Sửa lớp học phần</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="CourseClassId" />

    <div class="form-group">
        <label>Khóa học</label>
        <select asp-for="CourseId" asp-items="ViewBag.CourseId" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Giáo viên</label>
        <select asp-for="TeacherId" asp-items="ViewBag.TeacherId" class="form-control"></select>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
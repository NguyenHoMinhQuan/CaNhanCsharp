@model IEnumerable<BaiTapMVC.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h2>Danh sách sinh viên</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên</th>
            <th width="250">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.StudentId">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@item.StudentId">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.StudentId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/" class="btn btn-dark">🏠 Dashboard</a>
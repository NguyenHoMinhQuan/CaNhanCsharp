@model IEnumerable<BaiTapMVC.Models.Teacher>

@{
    ViewData["Title"] = "Danh sách giáo viên";
}

<h2>Danh sách giáo viên</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Thêm giáo viên</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên giáo viên</th>
            <th width="250">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.TeacherId">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@item.TeacherId">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.TeacherId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/" class="btn btn-dark">🏠 Dashboard</a>
@model BaiTapMVC.Models.Teacher

@{
    ViewData["Title"] = "Chi tiết giáo viên";
}

<h2>Chi tiết giáo viên</h2>

<div>
    <p><strong>ID:</strong> @Model.TeacherId</p>
    <p><strong>Tên:</strong> @Model.Name</p>
</div>

<br />

<a asp-action="Edit" asp-route-id="@Model.TeacherId" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
@model BaiTapMVC.Models.Course

@{
    ViewData["Title"] = "Chi tiết khóa học";
}

<h2>Chi tiết khóa học</h2>

<div>
    <p><strong>ID:</strong> @Model.CourseId</p>
    <p><strong>Tên khóa học:</strong> @Model.CourseName</p>
</div>

<br />

<a asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
@model IEnumerable<BaiTapMVC.Models.Course>

@{
    ViewData["Title"] = "Danh sách khóa học";
}

<h2>Danh sách khóa học</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">➕ Thêm khóa học</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên khóa học</th>
            <th width="250">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CourseName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.CourseId">Chi tiết</a> |
                    <a asp-action="Edit" asp-route-id="@item.CourseId">Sửa</a> |
                    <a asp-action="Delete" asp-route-id="@item.CourseId">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<a href="/" class="btn btn-dark">🏠 Dashboard</a>